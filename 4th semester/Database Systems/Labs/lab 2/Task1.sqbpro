    Course_id TEXT PRIMARY KEY,
    Credit_hours INTEGER
);

INSERT INTO Courses (Course_id, Credit_hours)
VALUES 
('124DSA', 3),
('Database', 4),
('Networking', 3),
('Programming', 4),
('English', 3),
(NULL,5);






CREATE TABLE Students (
    S_ID TEXT PRIMARY KEY,
    S_fname TEXT,
    S_lname TEXT,
    S_age INT,
    S_dept TEXT,
    S_course TEXT,
    FOREIGN KEY (S_course) REFERENCES Courses(Course_id)
);


