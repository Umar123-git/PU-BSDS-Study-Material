<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="all tasks.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="902"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="BONUS" custom_title="0" dock_id="1" table="4,5:mainBONUS"/><dock_state state="000000ff00000000fd000000010000000200000330000001fcfc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003300000011800ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="BONUS" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="48"/><column index="2" value="30"/><column index="3" value="29"/><column index="4" value="44"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT *
FROM EMP,DEPT


1.
select ENAME,sal, SAL+(SAL * 0.15)
FROM emp 



2.
select ENAME, round(sal*12,0)
from EMP


3. 
SELECT ename, length(JOB)
from EMP


4.
SELECT ENAME, substr(ENAME,length(ENAME)-1,length(ENAME))
FROM EMP


5.
SELECT ENAME, RPAD (SAL,10,'*')
FROM EMP


6.
SELECT ENAME, 
decode(true,
'HIGH',sal&gt;=7000,
'MEDIUM',SAL&gt;=4000,
'LOW')
FROM EMP


7.
SELECT ENAME, COMM
FROM EMP


8. 
SELECT ENAME, DNAME
FROM EMP E, DEPT D
WHERE
E.DEPTNO = D.DEPTNO



9. 
SELECT ENAME, DNAME, LOC
FROM EMP, DEPT
WHERE SAL&gt;3000



10.
SELECT ENAME 
FROM EMP E, DEPT D
WHERE 
E.DEPTNO = D.DEPTNO
AND 
LOC='DALLAS'



11.
SELECT D.DNAME, SUM(E.SAL) TOTAL_SAL
FROM EMP E
JOIN DEPT D ON E.deptno = D.deptno
GROUP BY D.DNAME
ORDER BY TOTAL_SAL DEC



12.
SELECT DEPTNO, AVG(SAL) AS AVG_SALARY
FROM EMP
GROUP BY DEPTNO
HAVING COUNT(EMPNO)&gt;3



13.
SELECT E.ENAME EMPLOYEE, M.ENAME MANAGER
FROM EMP E
JOIN EMP M ON E.EMPNO = M.EMPNO





14.
SELECT E.ENAME, E.SAL
FROM EMP E
WHERE SAL&gt;(
		SELECT AVG(SAL)
		FROM EMP
		WHERE DEPTNO = 20
		)
		
		
15.
SELECT *
FROM EMP E
WHERE E.SAL = (
		SELECT MAX(M.SAL)
		FROM EMP M
		WHERE M.DEPTNO = E.DEPTNO
		)
		
		
		
16.
SELECT ENAME,DEPTNO
FROM EMP
WHERE DEPTNO = (
		SELECT DEPTNO
		FROM EMP
		WHERE ENAME = 'ÁLLEN'
		)
		
		
		
17.
SELECT *
FROM EMP E
WHERE E.SAL &gt; ANY(
		SELECT M.SAL
		FROM EMP M
		WHERE M.DEPTNO = 30
		)
		
		
18.
SELECT ENAME, SAL
FROM EMP 
WHERE SAL&lt; ALL(
		SELECT SAL
		FROM EMP
		WHERE DEPTNO = 10
		)
		
		
19.
SELECT ENAME, LAST_DAY(HIREDATE) AS LAST_DAY_OF MONTH
FROM EMP


20.
SELECT ENAME, ADD_MONTHS(HIREDATE,6) AS HIREDATE_6
FROM EMP</sql><current_tab id="0"/></tab_sql></sqlb_project>
